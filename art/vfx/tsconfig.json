{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "removeComments": true
  },
  "include": [
    "core/**/*.ts",
    "tick-feedback/**/*.ts",
    "rarity-reveal/**/*.ts",
    "rift-reveal/**/*.ts",
    "hp-bar/**/*.ts",
    "hp-critical/**/*.ts",
    "run-state/**/*.ts",
    "quick-command/**/*.ts"
  ]
}
