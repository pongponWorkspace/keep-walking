# Owner: devops-engineer. See docs/tech/environments.md for the full explanation.
# This file lists variable NAMES only. Never put a real value here or in any committed file.
# Copy to .env.local (ignored by git) and fill in real values for local development.
#
# Repo is PUBLIC (D-002): committing a real value here would leak it to the world.
# CI's secret-scan job (gitleaks) and the forbidden-file guard both check this rule on every push.

# --- Client (Vite), read by apps/client via import.meta.env ---
# Either a TileJSON URL (Cloudflare Pages Free, XYZ tiles, D-031 -- no HTTP range request needed)
# or a `pmtiles://<url>` (local dev fixture, or the temporary GitHub Pages PMTiles fallback,
# which does use HTTP range requests). See docs/tech/F02-map-location-spike.md section 8.
# Local dev: point at a local static server or the fixture under tools/tiles/fixtures/.
# Preview (added by P1-F02-T08): `${TILES_PUBLIC_BASE_URL}/tiles/<tileset_id>/tiles.json`.
VITE_TILES_URL=

# Base URL that serves the map style's font glyphs (PBF glyph ranges) for MapLibre GL JS.
VITE_GLYPHS_URL=

# Base URL that serves the map style's sprite (sprite.png / sprite.json, and @2x variants).
VITE_SPRITE_URL=

# --- Deploy-side (used by publish/build scripts, not bundled into client code) ---
# Public base URL where published tiles/glyphs/sprites are reachable once deployed.
# This is a neutral name: it does NOT imply any specific storage backend (no R2 name here,
# see docs/tech/environments.md "ทำไมไม่มีชื่อ env ที่ผูกกับ R2"). Phase 1 target is Cloudflare
# Pages Free / GitHub Pages (fallback); a future move to R2 only changes this value.
TILES_PUBLIC_BASE_URL=

# --- Host credentials for the deploy-preview workflow (.github/workflows/deploy-preview.yml) ---
# Read by `wrangler` (infra/scripts/publish-tiles.sh, infra/scripts/publish-client.sh) and by
# nothing else. NEVER given a real value here: real values live only in GitHub Actions repository
# secrets (Settings > Secrets and variables > Actions, set by HUMAN P1-F02-T17) or a developer's
# own .env.local. See infra/runbooks/preview-setup.md for exact steps and the minimum token scope
# (Account > Cloudflare Pages > Edit -- nothing else). Not needed to run any local dev, lint, test,
# or build command: every infra/scripts/*.sh script treats a missing value as an offline dry run.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
