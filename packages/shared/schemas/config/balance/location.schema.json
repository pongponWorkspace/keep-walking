  "$id": "https://keep-walking.invalid/schemas/config/balance/location.schema.json",
  "title": "config/balance/location.json",
  "type": "object",
  "required": ["_meta", "homeState"],
  "properties": {
    "_meta": { "$ref": "../common.schema.json#/$defs/meta" },
    "homeState": {
