        "_source": { "$ref": "../common.schema.json#/$defs/source" },
        "maxAccuracy_m": { "$ref": "../common.schema.json#/$defs/meters" },
        "sustainedPoorAccuracy_s": { "$ref": "../common.schema.json#/$defs/seconds" },
        "seeCheckInAccuracy": { "$ref": "../common.schema.json#/$defs/pointer" }
      },
      "patternProperties": { "^_": {} }
    }
  },
  "patternProperties": { "^_": {} }
}
