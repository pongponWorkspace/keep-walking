{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keep-walking.invalid/schemas/gps-trace.schema.json",
  "title": "GPS trace (keep-walking.gps-trace v1)",
  "description": "Replayable GPS trace. Contract: docs/tech/gps-trace-format.md. The runtime validator is validateTrace() in packages/shared/src/trace.ts; both must agree (trace.test.ts cross-checks them).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "meta", "samples"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "keep-walking.gps-trace" },
    "formatVersion": { "const": 1 },
    "meta": { "$ref": "#/$defs/meta" },
    "samples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 200000,
      "items": { "$ref": "#/$defs/sample" }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "timeBase"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "kind": { "enum": ["synthetic", "qa", "field", "recorded"] },
        "timeBase": { "const": "relative-ms" },
        "description": { "type": "string", "maxLength": 500 },
        "environment": { "enum": ["park", "soi", "street", "table", "bench", "mixed", "other"] },
        "platform": { "enum": ["android-chrome", "ios-safari", "desktop", "synthetic"] },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "version"],
          "properties": {
            "tool": { "type": "string", "maxLength": 100 },
            "version": { "type": "string", "maxLength": 50 },
            "seed": { "type": "integer" },
            "scenario": { "type": "string", "maxLength": 100 }
          }
        },
        "sanitized": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trimStart_m", "trimEnd_m"],
          "properties": {
            "trimStart_m": { "type": "number", "minimum": 0 },
            "trimEnd_m": { "type": "number", "minimum": 0 },
            "coordinateDecimals": { "type": "integer", "minimum": 0, "maximum": 7 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["field", "recorded"] } } },
          "then": { "required": ["sanitized"], "properties": { "sanitized": true } }
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "lat", "lng", "accuracy"],
      "properties": {
        "t": { "type": "integer", "minimum": 0 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "accuracy": { "type": "number", "exclusiveMinimum": 0 },
        "speed": { "type": "number", "minimum": 0 },
        "heading": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "type"],
      "properties": {
        "t": { "type": "integer", "minimum": 0 },
        "type": {
          "enum": [
            "visibility-hidden",
            "visibility-visible",
            "permission-denied",
            "position-unavailable",
            "timeout"
          ]
        }
      }
    }
  }
}
