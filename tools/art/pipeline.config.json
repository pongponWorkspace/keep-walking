{
  "_comment": "Every tunable value of tools/art (P2-F06-T07). manifestPart + manifestRoots: the per-root split of the artist manifest (P2-X22, asset-pipeline 3.1 root list and 7.2, docs/tech/asset-delivery.md 10.1). A manifestRoots key is a root or root.group; an entry goes to the most specific key (P2-H67: icon split by group after manifest.icon.json passed budgets.manifestBytes; plain icon keeps any other icon group, e.g. icon.qc). Sources: art/direction/asset-pipeline.md (sections noted per key), art/direction/avatar-spec.md 6 and 7.4, art/direction/style-guide.md 3 and 6. Change a value here only after the owning doc changes.",
  "paths": {
    "manifest": "art/assets/manifest.json",
    "manifestPart": "art/assets/manifest.{root}.json",
    "buildManifest": "art/assets/manifest.build.json",
    "schema": "art/assets/manifest.schema.json",
    "assetsDir": "art/assets",
    "srcDir": "art/src",
    "fontsDir": "art/fonts",
    "fontsManifest": "art/fonts/fonts.json",
    "fontsSha256Sums": "art/fonts/SHA256SUMS",
    "tokens": "design/ux/tokens.json",
    "audioGenerator": "audio/src/generate.ts",
    "audioManifest": "audio/manifest.json",
    "audioOut": "audio/out",
    "stageOut": "tools/art/out/client"
  },
  "manifestRoots": [
    "avatar",
    "badge",
    "font",
    "frame",
    "icon",
    "icon.item",
    "icon.ui",
    "icon.ui16",
    "illus",
    "map",
    "ref",
    "ui",
    "vfx"
  ],
  "runtimeParts": {
    "_comment": "P2-X24, docs/tech/asset-delivery.md 5.1: entries of these kinds leave asset-manifest.json for a lazily loaded part (asset-pipeline 7.2: the avatar loads after the map is shown). path is relative to the staged folder; under art/ so the immutable cache rule of 6.2 applies (the URL carries ?v=).",
    "parts": {
      "avatar": {
        "kinds": [
          "avatar-layer"
        ],
        "path": "art/avatar/runtime-manifest.json"
      }
    }
  },
  "unlistedFilesAllowed": [
    "manifest.json",
    "manifest.schema.json",
    "manifest.build.json",
    "OFL.txt",
    ".DS_Store"
  ],
  "pathExceptionRoots": [
    "map",
    "ref"
  ],
  "spdxAllowed": [
    "LicenseRef-KeepWalking-Original",
    "OFL-1.1"
  ],
  "svg": {
    "_comment": "asset-pipeline 4.1 and style-guide 6.3 (no gradient, no blur).",
    "forbiddenElements": [
      "image",
      "text",
      "script",
      "foreignObject",
      "linearGradient",
      "radialGradient",
      "filter"
    ],
    "colorAttributes": [
      "fill",
      "stroke",
      "stop-color",
      "flood-color",
      "lighting-color",
      "color"
    ],
    "opacityAttributes": [
      "opacity",
      "fill-opacity",
      "stroke-opacity"
    ],
    "opacityException": {
      "color": "#1A1A22",
      "value": 0.2
    },
    "currentColorKinds": [
      "icon-ui"
    ],
    "keywordsAllowed": [
      "none",
      "currentColor",
      "transparent"
    ],
    "miterRequiredIds": [
      "map.icon.rift-crack",
      "icon.ui.rift",
      "icon.ui.in-run",
      "icon.ui.enter"
    ],
    "miterLimit": 4
  },
  "keyColors": {
    "_comment": "avatar-spec 7.4. Allowed only in masters under keyColorDirs (V8).",
    "skin": {
      "top": "#FF40FF",
      "left": "#C020C0",
      "right": "#800080"
    },
    "hair": {
      "top": "#40FFFF",
      "left": "#20C0C0",
      "right": "#008080"
    }
  },
  "keyColorDirs": [
    "art/src/avatar/body/",
    "art/src/avatar/hair/",
    "art/src/avatar/pose-hand/"
  ],
  "avatar": {
    "_comment": "avatar-spec 6: sheet size at 1x and the variant axis per layer.",
    "frame": {
      "width": 128,
      "height": 160
    },
    "layers": {
